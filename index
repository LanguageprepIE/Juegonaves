<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Misión Compras: Arcade Spanish</title>
<style>
  :root {
    --bg-color: #0b0f19;
    --accent: #00f0ff;
    --success: #39ff14;
    --danger: #ff0055;
    --card-bg: rgba(255, 255, 255, 0.07);
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-color);
    color: #fff;
    font-family: 'Segoe UI', system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    overflow: hidden;
    user-select: none;
  }

  /* --- PANTALLAS --- */
  .screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 800px;
    max-width: 95vw;
  }
  .active { display: flex; }

  h1 { margin: 0 0 10px 0; color: var(--accent); text-transform: uppercase; letter-spacing: 2px; }
  p { margin: 5px 0 20px 0; color: #cbd5e1; font-size: 1.05rem; }

  /* --- FASE 1: MATCHING --- */
  #match-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    width: 100%;
    margin-bottom: 25px;
  }
  .match-card {
    background: var(--card-bg);
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 18px 10px;
    text-align: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }
  .match-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .match-card.selected { border-color: var(--accent); background: rgba(0, 240, 255, 0.2); }
  .match-card.matched { border-color: var(--success); background: rgba(57, 255, 20, 0.2); opacity: 0.5; pointer-events: none; }

  button.btn {
    background: var(--accent);
    color: #000;
    border: none;
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 6px;
    cursor: pointer;
    text-transform: uppercase;
    transition: 0.2s;
  }
  button.btn:disabled { background: #475569; color: #94a3b8; cursor: not-allowed; }
  button.btn:hover:not(:disabled) { transform: scale(1.05); box-shadow: 0 0 15px var(--accent); }

  /* --- FASE 2: CANVAS SHOOTER --- */
  #game-container {
    position: relative;
    border: 2px solid #334155;
    border-radius: 10px;
    box-shadow: 0 0 30px rgba(0,0,0,0.8);
  }
  canvas {
    background: radial-gradient(circle at bottom, #1e1b4b 0%, #050510 100%);
    display: block;
    border-radius: 8px;
  }
  #hud {
    position: absolute;
    top: 10px;
    left: 15px;
    right: 15px;
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 1.1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
    pointer-events: none;
  }

  /* --- MODAL DE RESCATE --- */
  #revive-modal {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(11, 15, 25, 0.95);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 20px;
    box-sizing: border-box;
    text-align: center;
  }
  .revive-options { display: flex; gap: 15px; margin-top: 20px; }
  .revive-btn {
    background: #1e293b;
    border: 2px solid #475569;
    color: #fff;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
  }
  .revive-btn:hover { border-color: var(--accent); }
</style>
</head>
<body>

  <!-- PANTALLA 1: WARM-UP (MATCHING) -->
  <div id="screen-match" class="screen active">
    <h1>Misión: De Compras</h1>
    <p>Empareja el vocabulario en español con su significado antes de despegar.</p>
    <div id="match-grid"></div>
    <button id="start-btn" class="btn" disabled>Despegar (Bloqueado)</button>
  </div>

  <!-- PANTALLA 2: SHOOTER -->
  <div id="screen-game" class="screen">
    <div id="game-container">
      <div id="hud">
        <span id="hud-prompt" style="color: var(--accent);">Pregunta</span>
        <span id="hud-score">Puntos: 0</span>
        <span id="hud-shield">Escudo: 100%</span>
      </div>
      <canvas id="canvas" width="800" height="500"></canvas>

      <!-- Pantalla de Rescate si cae el escudo -->
      <div id="revive-modal">
        <h2 style="color: var(--danger); margin-top: 0;">¡ESCUDO AGOTADO!</h2>
        <p style="font-size: 1.2rem;">Responde correctamente para recargar tus sistemas:</p>
        <p id="revive-q" style="font-weight: 700; color: var(--accent); font-size: 1.3rem;"></p>
        <div class="revive-options" id="revive-opts"></div>
      </div>
    </div>
  </div>

<script>
/* ========================================================
   BANCO DE DATOS (Fácilmente adaptable a otros temas)
======================================================== */
const VOCAB_PAIRS = [
  { es: "Probarse", en: "To try on" },
  { es: "La talla", en: "The size" },
  { es: "Me queda bien", en: "It fits me well" },
  { es: "Rebajas", en: "Sales / Discounts" },
  { es: "Estrecho", en: "Tight" },
  { es: "El probador", en: "Fitting room" }
];

// Preguntas del Shooter
const GAME_QUESTIONS = [
  {
    prompt: '"It fits me too tight": Me queda demasiado...',
    correct: "estrecho",
    distractors: ["ancho", "barato"]
  },
  {
    prompt: 'Lugar donde te pruebas la ropa:',
    correct: "el probador",
    distractors: ["la caja", "el escaparate"]
  },
  {
    prompt: '"¿Tiene una ____ más pequeña?" (Size)',
    correct: "talla",
    distractors: ["cuenta", "tarjeta"]
  },
  {
    prompt: '"I want to try on these jeans": Quiero...',
    correct: "probarme",
    distractors: ["pagar", "llevarme"]
  },
  {
    prompt: 'Precios más bajos en enero y julio:',
    correct: "las rebajas",
    distractors: ["los recibos", "las propinas"]
  },
  {
    prompt: '"How much does this jacket cost?": ¿Cuánto...?',
    correct: "cuesta",
    distractors: ["pesa", "queda"]
  }
];

// Preguntas rápidas de rescate (para recuperar vida sin reiniciar)
const RESCUE_QUESTIONS = [
  { q: "¿Dónde pagas la ropa?", a: "En la caja", options: ["En la caja", "En el probador"] },
  { q: "Lo contrario de 'caro' es...", a: "Barato", options: ["Barato", "Estrecho"] },
  { q: "¿Qué pides si los zapatos son pequeños? Una talla más...", a: "Grande", options: ["Grande", "Corta"] }
];

/* ========================================================
   LÓGICA FASE 1: MATCHING
======================================================== */
let selectedCards = [];
let matchedCount = 0;

function setupMatching() {
  const grid = document.getElementById("match-grid");
  grid.innerHTML = "";
  
  let cards = [];
  VOCAB_PAIRS.forEach((item, idx) => {
    cards.push({ text: item.es, id: idx, type: "es" });
    cards.push({ text: item.en, id: idx, type: "en" });
  });
  cards.sort(() => Math.random() - 0.5);

  cards.forEach(c => {
    const el = document.createElement("div");
    el.className = "match-card";
    el.innerText = c.text;
    el.dataset.id = c.id;
    el.onclick = () => selectCard(el);
    grid.appendChild(el);
  });
}

function selectCard(el) {
  if (selectedCards.length === 1 && selectedCards[0] === el) return;
  el.classList.add("selected");
  selectedCards.push(el);

  if (selectedCards.length === 2) {
    const [c1, c2] = selectedCards;
    if (c1.dataset.id === c2.dataset.id) {
      c1.classList.add("matched");
      c2.classList.add("matched");
      matchedCount++;
      if (matchedCount === VOCAB_PAIRS.length) {
        const btn = document.getElementById("start-btn");
        btn.disabled = false;
        btn.innerText = "¡Iniciar Misión!";
      }
    } else {
      setTimeout(() => {
        c1.classList.remove("selected");
        c2.classList.remove("selected");
      }, 500);
    }
    selectedCards = [];
  }
}

document.getElementById("start-btn").onclick = () => {
  document.getElementById("screen-match").classList.remove("active");
  document.getElementById("screen-game").classList.add("active");
  initGame();
};

/* ========================================================
   LÓGICA FASE 2: SHOOTER (Canvas)
======================================================== */
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

let player, bullets, enemies, stars;
let score = 0;
let shield = 100;
let currentQIdx = 0;
let keys = {};
let isPaused = false;

window.addEventListener("keydown", e => { 
  keys[e.code] = true;
  if (e.code === "Space" && !isPaused) fireBullet();
});
window.addEventListener("keyup", e => keys[e.code] = false);

function initGame() {
  player = { x: canvas.width / 2 - 20, y: canvas.height - 50, w: 40, h: 25, speed: 6 };
  bullets = [];
  enemies = [];
  stars = Array.from({length: 40}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    speed: Math.random() * 2 + 0.5
  }));
  loadQuestion(0);
  requestAnimationFrame(gameLoop);
}

function loadQuestion(idx) {
  currentQIdx = idx % GAME_QUESTIONS.length;
  const q = GAME_QUESTIONS[currentQIdx];
  document.getElementById("hud-prompt").innerText = q.prompt;

  // Generar 3 opciones (1 correcta, 2 distractores) repartidas en el eje X
  enemies = [];
  let options = [
    { text: q.correct, isCorrect: true },
    { text: q.distractors[0], isCorrect: false },
    { text: q.distractors[1], isCorrect: false }
  ].sort(() => Math.random() - 0.5);

  const laneWidth = canvas.width / 3;
  options.forEach((opt, i) => {
    enemies.push({
      x: i * laneWidth + laneWidth / 2 - 60,
      y: -40,
      w: 120,
      h: 35,
      speed: 1.2,
      text: opt.text,
      isCorrect: opt.isCorrect
    });
  });
}

function fireBullet() {
  bullets.push({ x: player.x + player.w / 2 - 2, y: player.y, w: 4, h: 10, speed: 8 });
}

function update() {
  if (isPaused) return;

  // Movimiento jugador (Flechas o A/D)
  if ((keys["ArrowLeft"] || keys["KeyA"]) && player.x > 0) player.x -= player.speed;
  if ((keys["ArrowRight"] || keys["KeyD"]) && player.x < canvas.width - player.w) player.x += player.speed;

  // Fondo estrellas
  stars.forEach(s => {
    s.y += s.speed;
    if (s.y > canvas.height) s.y = 0;
  });

  // Balas
  bullets.forEach((b, i) => {
    b.y -= b.speed;
    if (b.y < 0) bullets.splice(i, 1);
  });

  // Naves / Opciones
  let resetWave = false;
  enemies.forEach((enemy, eIdx) => {
    enemy.y += enemy.speed;

    // Colisión bala con enemigo
    bullets.forEach((b, bIdx) => {
      if (b.x < enemy.x + enemy.w && b.x + b.w > enemy.x &&
          b.y < enemy.y + enemy.h && b.y + b.h > enemy.y) {
        
        bullets.splice(bIdx, 1);
        if (enemy.isCorrect) {
          score += 100;
          document.getElementById("hud-score").innerText = `Puntos: ${score}`;
          resetWave = true;
        } else {
          damageShield(20);
          enemies.splice(eIdx, 1); // Destruir la nave errónea
        }
      }
    });

    // Tocar el suelo
    if (enemy.y > canvas.height - 40) {
      if (enemy.isCorrect) damageShield(15);
      resetWave = true;
    }
  });

  if (resetWave) loadQuestion(currentQIdx + 1);
}

function damageShield(amount) {
  shield = Math.max(0, shield - amount);
  document.getElementById("hud-shield").innerText = `Escudo: ${shield}%`;
  if (shield === 0) triggerRevival();
}

function triggerRevival() {
  isPaused = true;
  const modal = document.getElementById("revive-modal");
  const qObj = RESCUE_QUESTIONS[Math.floor(Math.random() * RESCUE_QUESTIONS.length)];
  
  document.getElementById("revive-q").innerText = qObj.q;
  const optsContainer = document.getElementById("revive-opts");
  optsContainer.innerHTML = "";

  qObj.options.forEach(opt => {
    const btn = document.createElement("button");
    btn.className = "revive-btn";
    btn.innerText = opt;
    btn.onclick = () => {
      if (opt === qObj.a) {
        shield = 60;
        document.getElementById("hud-shield").innerText = `Escudo: ${shield}%`;
        modal.style.display = "none";
        isPaused = false;
        loadQuestion(currentQIdx);
      } else {
        btn.style.borderColor = "var(--danger)";
      }
    };
    optsContainer.appendChild(btn);
  });

  modal.style.display = "flex";
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Estrellas
  ctx.fillStyle = "#fff";
  stars.forEach(s => ctx.fillRect(s.x, s.y, 2, 2));

  // Jugador (Nave estilizada)
  ctx.fillStyle = "#00f0ff";
  ctx.beginPath();
  ctx.moveTo(player.x + player.w / 2, player.y);
  ctx.lineTo(player.x + player.w, player.y + player.h);
  ctx.lineTo(player.x, player.y + player.h);
  ctx.closePath();
  ctx.fill();

  // Balas
  ctx.fillStyle = "#39ff14";
  bullets.forEach(b => ctx.fillRect(b.x, b.y, b.w, b.h));

  // Naves de vocabulario
  enemies.forEach(e => {
    ctx.fillStyle = "#1e293b";
    ctx.strokeStyle = "#00f0ff";
    ctx.lineWidth = 2;
    ctx.fillRect(e.x, e.y, e.w, e.h);
    ctx.strokeRect(e.x, e.y, e.w, e.h);

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 13px 'Segoe UI', sans-serif";
    ctx.textAlign = "center";
    ctx.fillText(e.text, e.x + e.w / 2, e.y + e.h / 2 + 5);
  });
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

// Inicializar el matching al cargar
setupMatching();
</script>
</body>
</html>
